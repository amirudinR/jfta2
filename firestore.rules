rules_version = '2';

// 暗記帳 — Firestore Security Rules
// Setiap user hanya bisa mengakses data miliknya sendiri (users/{uid}).
// Struktur:
//   users/{uid}                      -> profil (displayName, email, photoURL, lastLogin)
//   users/{uid}/progress/main        -> progress belajar (perMaterial, prefs, updated, syncedAt)
//   users/{uid}/exams/{examId}       -> riwayat ujian (score, total, category, difficulty, ...)
//   users/{uid}/hh/{key}             -> data live-sync (data, updated, syncedAt)

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Validasi ukuran & tipe dasar untuk mencegah data sampah / penyalahgunaan.
    function validProfile() {
      return request.resource.data.keys().hasOnly(
        ['displayName', 'email', 'photoURL', 'lastLogin']
      )
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly(
        ['perMaterial', 'prefs', 'tombstone', 'updated', 'syncedAt']
      )
        && request.resource.data.tombstone is map;
    }

    function validExam() {
      return request.resource.data.keys().hasOnly(
        ['score', 'total', 'category', 'difficulty', 'difficultyLabel', 'level', 'wrongCount', 'categories', 'date', 'createdAt']
      )
        && request.resource.data.score is number
        && request.resource.data.total is number
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total <= 500;
    }

    // Data live-sync: { data: apapun, updated: epoch ms, syncedAt: serverTimestamp }.
    function validHh() {
      return request.resource.data.keys().hasOnly(['data', 'updated', 'syncedAt'])
        && request.resource.data.updated is number
        && request.resource.data.updated > 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if isOwner(uid);

      match /progress/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && validProgress();
      }

      match /exams/{examId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validExam();
        // Riwayat ujian bersifat append-only: tidak boleh diubah/dihapus dari client.
        allow update, delete: if false;
      }

      // Semua dokumen live-sync di bawah users/{uid}/hh (termasuk subkoleksi
      // checked/history/custom per mode) — hanya pemilik yang boleh akses.
      match /hh/{allPaths=**} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validHh();
        allow delete: if isOwner(uid);
      }
    }

    // Tolak semua akses lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
